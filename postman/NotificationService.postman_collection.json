{
  "info": {
    "_postman_id": "f1c6b8a4-7d2e-4a9f-8c3b-6e1d5a0f2b7c",
    "name": "NotificationService",
    "description": "Notification-service API (stateless, log-based notifications). Select the 'NotificationService Local' environment before running so {{baseUrl}}/{{authBaseUrl}} resolve. Run the folders top-to-bottom: 'Setup' registers and logs in a user against auth-service, and 'Notifications' exercises POST /api/notifications for each NotificationType plus the unauthenticated/invalid-input edge cases. Integration note: order-service and payment-service do not call notification-service automatically yet - that wiring is tracked as separate follow-up work, so this collection calls the endpoint directly to verify it in isolation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "userEmail", "value": "", "type": "string" },
    { "key": "userPassword", "value": "SecureP@ss1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register (AuthService)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"userEmail\", \"notification.\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Notification Tester\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/register",
              "host": [ "{{authBaseUrl}}" ],
              "path": [ "api", "auth", "register" ]
            },
            "description": "Registers a new user in auth-service with a freshly generated unique email, so the collection can be re-run without hitting a duplicate-email conflict."
          },
          "response": []
        },
        {
          "name": "Login (AuthService)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Response has an accessToken\", function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/login",
              "host": [ "{{authBaseUrl}}" ],
              "path": [ "api", "auth", "login" ]
            },
            "description": "Logs in with the user created by 'Register (AuthService)' and stores the returned access token, used as the Bearer token for every notification-service request below. Run 'Register (AuthService)' first."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Notify (No Token - Expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"11111111-1111-1111-1111-111111111111\",\n  \"type\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notifications" ]
            },
            "description": "Calls POST /api/notifications without an Authorization header. Expects 401 Unauthorized."
          },
          "response": []
        },
        {
          "name": "Notify (Empty OrderId - Expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"00000000-0000-0000-0000-000000000000\",\n  \"type\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notifications" ]
            },
            "description": "Submits an empty OrderId, which fails the NotEmpty validation rule. Expects 400 Bad Request from FluentValidation. Run the 'Setup' folder first."
          },
          "response": []
        },
        {
          "name": "Notify Order Created (Expect 202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 202\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"11111111-1111-1111-1111-111111111111\",\n  \"type\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notifications" ]
            },
            "description": "Records an OrderCreated notification for the authenticated user. Expects 202 Accepted. Run the 'Setup' folder first."
          },
          "response": []
        },
        {
          "name": "Notify Payment Succeeded (Expect 202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 202\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"11111111-1111-1111-1111-111111111111\",\n  \"type\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notifications" ]
            },
            "description": "Records a PaymentSucceeded notification for the authenticated user. Expects 202 Accepted. Run the 'Setup' folder first."
          },
          "response": []
        },
        {
          "name": "Notify Payment Failed (Expect 202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 202\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"11111111-1111-1111-1111-111111111111\",\n  \"type\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "notifications" ]
            },
            "description": "Records a PaymentFailed notification for the authenticated user. Expects 202 Accepted. Run the 'Setup' folder first."
          },
          "response": []
        }
      ]
    }
  ]
}
